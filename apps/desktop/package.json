{
  "name": "@ckh/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "CKH ONE POS for Windows",
  "author": "CKH ONE",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "start": "pnpm build && electron .",
    "web": "node scripts/copy-web.js",
    "dist:win": "pnpm build && pnpm web && electron-builder --win nsis --config electron-builder.config.js --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@swc/core": "^1.7.40",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "jest": "^29.7.0",
    "playwright-core": "1.49.1",
    "typescript": "^5.6.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": "@swc/jest"
    },
    "testMatch": [
      "**/test/**/*.spec.ts"
    ]
  }
}
