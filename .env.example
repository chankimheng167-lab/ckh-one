DATABASE_URL=postgres://ckh_app_user:change-me@localhost:5433/ckh_one
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5433/ckh_one
JWT_SECRET=replace-with-at-least-32-random-characters
# Access tokens are short-lived; devices stay signed in with rotating refresh tokens.
JWT_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
SUPERADMIN_EMAIL=superadmin@ckh.one
# Required in production (and must not be the public demo password).
SUPERADMIN_PASSWORD=
# Demo company: seeded by default in development, never in production unless SEED_DEMO=true and DEMO_PASSWORD is set.
SEED_DEMO=
DEMO_PASSWORD=
# Web app origin(s), comma-separated. Required in production.
CORS_ORIGINS=http://localhost:3100
PORT=3001
